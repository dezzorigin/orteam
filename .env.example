# Orteam — contoh konfigurasi environment.
# Salin ke `.env.local` dan isi nilainya. JANGAN commit `.env.local`.
# Tanpa variabel ini aplikasi tetap jalan dalam MODE DEMO
# (workspace tersimpan di localStorage browser, tanpa backend).

# Supabase (opsional — mode produksi)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-publik>

# Hanya untuk server; JANGAN PERNAH mengekspos ke klien atau men-commit-nya.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Clerk (opsional — jalur auth produksi, lihat docs/ARCHITECTURE.md)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
